# Userlify Environment Variables
# Copy this file to .env.local and fill in the values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Userlify

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# API Keys (add as needed)
# NEXT_PUBLIC_API_KEY=

# Contact Form (add your email service credentials)
# RESEND_API_KEY=
# CONTACT_EMAIL=
